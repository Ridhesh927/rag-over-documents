# RAG Over Documents Configuration
PROJECT_NAME="RAG Over Documents Microservice"
ENVIRONMENT="development"
PORT=8001
DEBUG=True

# LLM & Embedding Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="models/text-embedding-004"

# Optional: Neon PostgreSQL / pgvector Database URL
# e.g., postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100
DEFAULT_TOP_K=4
